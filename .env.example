# PROFILE AND LOCAL DOCUMENTS
# Paths are relative to the project root; PDFs need extractable text (no OCR).
RESEARCH_PROFILE=research_profile.md
REFERENCE_DIR=references

# ARXIV SOURCE: rss (default), api or auto (API with fallback after HTTP 429/503).
# RSS uses categories and recent announcements, without a query or date window.
ARXIV_SOURCE=rss
ARXIV_RSS_CATEGORIES=astro-ph.EP,astro-ph.IM
# Expression and pagination are used only in api/auto; adapt them to your topic.
ARXIV_QUERY=(cat:astro-ph.IM OR cat:astro-ph.HE OR cat:cs.LG)
CONTACT_EMAIL=your-email@example.org
LOOKBACK_DAYS=7
PAGE_SIZE=100
# Limits for retrieval, detailed analysis and inclusion in the digest.
MAX_ARXIV_RESULTS=500
MAX_LLM_EVALUATIONS=40
MAX_EMAIL_PAPERS=12
RELEVANCE_THRESHOLD=70

# LOCAL OLLAMA: see the README for memory, disk and compatibility requirements.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.6:35b-a3b
EMBED_MODEL=embeddinggemma

# SMTP EMAIL: use your provider's SMTP credential or application password.
# 587 = STARTTLS; 465 = implicit TLS. OAuth2 is not implemented.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=your-email@example.org
SMTP_PASSWORD=replace-with-app-password
EMAIL_FROM=your-email@example.org
# Multiple recipients can be separated by commas.
EMAIL_TO=your-email@example.org
# true sends a digest even when no papers meet the threshold.
EMAIL_ALWAYS_SEND=false
